meta {
  name: get account summary by current user
  type: http
  seq: 2
}

post {
  url: {{SUPABASE_URL}}/rest/v1/rpc/get_account_summary_by_current_user
  body: json
  auth: none
}

headers {
  apikey: {{SUPABASE_PUBLISHABLE_KEY}}
  Authorization: Bearer {{SUPABASE_ACCESS_TOKEN}}
  Content-Type: application/json
  Accept-Profile: api
  Content-Profile: api
}

body:json {
  {
    "include_organisations": true
  }
}

docs {
  Returns the authenticated account identity and, when include_organisations is true, the active organisation summary in one database query. Disabled-organisation applications pass false so the RPC does not query organisation context. Avatar values are private storage paths; the application signs only the media required by the current interface.
}
