meta {
  name: is profile complete by current user
  type: http
  seq: 2
}

post {
  url: {{SUPABASE_URL}}/rest/v1/rpc/is_profile_complete_by_current_user
  body: json
  auth: none
}

headers {
  apikey: {{SUPABASE_PUBLISHABLE_KEY}}
  Authorization: Bearer {{SUPABASE_ACCESS_TOKEN}}
  Content-Type: application/json
  Accept-Profile: api
  Content-Profile: api
}

body:json {
  {
    "input_username_required": false
  }
}

docs {
  Returns whether the signed-in user's required profile fields are complete. Pass true only when PROFILE_IDENTITY.USERNAME is required.
}
