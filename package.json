{
  "name": "supacharger",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--trace-deprecation --max-http-header-size=32768' next dev --port 3400",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "stripe:listen": "stripe listen --forward-to=localhost:3000/api/webhooks --project-name=default",
    "generate-types": "node src/supacharger/generate-database-types.cjs --local",
    "supabase:link": "supabase link",
    "migration:new": "supabase migration new",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local",
    "db:push:dry-run": "supabase db push --linked --dry-run",
    "db:push:linked": "supabase db push --linked",
    "db:schema:plan": "node src/supacharger/plan-declarative.cjs",
    "setup:ui": "node src/supacharger/setup-ui.cjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hiseb/confetti": "2.2.0",
    "@milkdown/crepe": "7.23.0",
    "@next/third-parties": "16.4.6",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "email-validator": "2.0.4",
    "embla-carousel": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.72.0",
    "motion": "14.12.0",
    "next": "16.4.6",
    "next-intl": "4.15.0",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-animate-height": "^3.2.4",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-resizable-panels": "4.21.0",
    "react-toastify": "11.2.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "stripe": "23.1.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "typewriter-effect": "3.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@supabase/pg-delta": "1.0.0-alpha.60",
    "@supabase/pg-topo": "1.0.0-alpha.8",
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "env-cmd": "11.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "postcss": "8.5.32",
    "prettier": "3.10.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "shiki": "4.6.0",
    "supabase": "3.1.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "7.29.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "svgo": "3.3.5",
    "whatwg-url": "^14.1.0"
  }
}
