{
  "version": 1,
  "managedPaths": [
    ".supacharger/managed-files.json",
    "components.json",
    "package-lock.json",
    "package.json",
    "src/app/(supacharger)",
    "src/assets",
    "src/lib/supabase/middleware.ts",
    "src/lib/supabase/supacharger",
    "src/proxy.ts",
    "src/supacharger",
    "tailwind.config.ts",
    "tsconfig.json",
    "supabase/config.toml",
    "supabase/functions/_shared/image-target-contract.ts",
    "supabase/functions/_shared/image-transform-runtime.test.ts",
    "supabase/functions/_shared/image-transform.ts",
    "supabase/functions/process-image-upload",
    "supabase/migrations",
    "supabase/templates",
    "test/auth-action-result.test.mjs",
    "test/auth-journey-contract.test.mjs",
    "test/image-transform-contract.test.mjs",
    "test/billing-schema-contract.test.mjs",
    "test/tooling-contract.test.mjs"
  ],
  "developerOwnedPaths": [
    ".supacharger/core-lock.json",
    "messages",
    "supabase/functions/_shared/image-targets.ts",
    "src/app/layout.tsx",
    "src/app/(project)",
    "src/components/sc_demo",
    "src/i18n/config.ts",
    "src/i18n/request.ts",
    "src/styles/project.css",
    "src/supacharger.adapters",
    "src/supacharger.config.ts"
  ],
  "postUpdateChecks": [
    "lint",
    "typecheck",
    "test:auth-proxy",
    "test:auth-journey",
    "test:image-transform",
    "test:image-transform-runtime",
    "test:billing-schema",
    "test:tooling",
    "check:bruno-rpcs"
  ]
}
