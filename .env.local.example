# Update these with your Supabase details from your project settings > API
NEXT_PUBLIC_SUPABASE_URL=UPDATE_THIS_WITH_YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=UPDATE_THIS_WITH_YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=UPDATE_THIS_WITH_YOUR_SUPABASE_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_DB_PASSWORD=UPDATE_THIS_WITH_YOUR_SUPABASE_SUPABASE_DB_PASSWORD
# For local development update these with your Stripe credentials from https://dashboard.stripe.com/test/apikeys eg. pk_test_f00b4r and sk_test_f00b4r
STRIPE_SECRET_KEY=UPDATE_THIS_WITH_YOUR_STRIPE_SK
# Webhook Signing secret  https://dashboard.stripe.com/test/workbench/webhooks/ eg. whsec_f00b4r
STRIPE_WEBHOOK_SECRET=UPDATE_THIS_WITH_YOUR_STRIPE_WHSEC
STRIPE_EVENT_PROCESSOR_SECRET=UPDATE_THIS_WITH_A_LONG_RANDOM_SECRET
STRIPE_RECONCILIATION_SECRET=UPDATE_THIS_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
# Env
NEXT_PUBLIC_SITE_URL=http://localhost:3400
# Optional public GA4 measurement ID (for example G-XXXXXXXXXX).
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
